<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LockIn.ViewModels"
             xmlns:controls="clr-namespace:LockIn.Controls"
             xmlns:loc="clr-namespace:LockIn.Resources.Strings"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             ios:Page.UseSafeArea="False"
             x:Class="LockIn.Views.PeriodizationPage"
             x:DataType="vm:PeriodizationViewModel"
             Title="{loc:Localize Periodization_Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Transparent">

    <Grid SafeAreaEdges="None">

        <!-- Atmosfärisk bakgrund -->
        <controls:AtmosphericBackgroundView InputTransparent="True"/>

        <!-- Permanent status bar gradient (Dynamic Island-zonen) -->
        <BoxView VerticalOptions="Start" HeightRequest="90" InputTransparent="True" ZIndex="19">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{AppThemeBinding Light=#28FCFCFC, Dark=#28141418}" Offset="0.0"/>
                    <GradientStop Color="{AppThemeBinding Light=#00FCFCFC, Dark=#00141418}" Offset="1.0"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Loader -->
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource ForgeAccent}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           ZIndex="5"/>

        <!-- Scroll-innehåll -->
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0">

                <!-- Header -->
                <Grid Padding="16,56,20,10" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Grid.Column="0"
                            Style="{StaticResource IconCircleButton}"
                            SemanticProperties.Description="{loc:Localize A11y_Back}">
                        <Path Style="{StaticResource BackChevron}"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <Label Grid.Column="1"
                           Text="MESOCYKLER"
                           FontFamily="BebasNeue" FontSize="38" CharacterSpacing="1"
                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource ForgeText}}"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- Två stora knappar -->
                <Grid Padding="16,4,16,16" ColumnDefinitions="*,*" ColumnSpacing="10">

                    <!-- Meso Builder (fylld) -->
                    <Border Grid.Column="0"
                            BackgroundColor="{StaticResource ForgeAccent}"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="0"
                            HeightRequest="86"
                            SemanticProperties.Description="{loc:Localize Periodization_MesoBuilder_A11y}">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="14" Opacity="0.28"/>
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="+"
                                   FontFamily="BebasNeue" FontSize="26"
                                   TextColor="{StaticResource ForgeFabForeground}"
                                   HorizontalOptions="Center"/>
                            <Label Text="MESO BUILDER"
                                   FontFamily="BebasNeue" FontSize="18" CharacterSpacing="2"
                                   TextColor="{StaticResource ForgeFabForeground}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenMesoBuilderCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Välj template (outline) -->
                    <Border Grid.Column="1"
                            BackgroundColor="Transparent"
                            Stroke="{StaticResource ForgeAccent}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 18"
                            HeightRequest="86"
                            SemanticProperties.Description="{loc:Localize Periodization_TemplatePicker_Button}">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="✓"
                                   FontFamily="BebasNeue" FontSize="24"
                                   TextColor="{StaticResource ForgeAccent}"
                                   HorizontalOptions="Center"/>
                            <Label Text="{loc:Localize Periodization_TemplatePicker_Button}"
                                   FontFamily="BebasNeue" FontSize="18" CharacterSpacing="2"
                                   TextColor="{StaticResource ForgeAccent}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenTemplatePickerCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>

                </Grid>

                <!-- Empty-state -->
                <VerticalStackLayout IsVisible="{Binding HasNoCycles}"
                                     Padding="32,60,32,40" Spacing="10">
                    <Label Text="{loc:Localize Periodization_Empty_Title}"
                           FontFamily="BebasNeue" FontSize="24" CharacterSpacing="1.5"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource ForgeMuted}"/>
                    <Label Text="{loc:Localize Periodization_Empty_Body}"
                           FontFamily="DMSansRegular" FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           TextColor="{StaticResource ForgeMuted}"/>
                </VerticalStackLayout>

                <!-- Cykel-lista -->
                <StackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="0" Padding="0,4,0,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:MesocycleRow">
                            <Border Margin="16,0,16,10"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource ForgeSurface}}"
                                    StrokeShape="RoundRectangle 18"
                                    StrokeThickness="0"
                                    Padding="18,16">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,3" Radius="12" Opacity="0.2"/>
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PeriodizationViewModel}}, Path=OpenMesocycleCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="10">

                                    <!-- Header rad: Namn + Aktiv-badge -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontFamily="BebasNeue" FontSize="22" CharacterSpacing="1"
                                               VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource ForgeText}}"/>
                                        <Border Grid.Column="1"
                                                IsVisible="{Binding IsActive}"
                                                BackgroundColor="{StaticResource ForgeAccentDim}"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                Padding="10,4"
                                                VerticalOptions="Center">
                                            <Label Text="{loc:Localize Periodization_Active_Badge}"
                                                   FontFamily="BebasNeue" FontSize="11" CharacterSpacing="1.5"
                                                   TextColor="{StaticResource ForgeAccent}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Sub-info -->
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding WeeksDisplay}"
                                               FontFamily="DMSansRegular" FontSize="13"
                                               TextColor="{StaticResource ForgeMuted}"/>
                                        <Label Text="·"
                                               FontFamily="DMSansRegular" FontSize="13"
                                               TextColor="{StaticResource ForgeMuted}"/>
                                        <Label Text="{Binding StartDateDisplay}"
                                               FontFamily="DMSansRegular" FontSize="13"
                                               TextColor="{StaticResource ForgeMuted}"/>
                                    </HorizontalStackLayout>

                                    <!-- Progress för aktiva -->
                                    <VerticalStackLayout IsVisible="{Binding IsActive}" Spacing="6">
                                        <Label Text="{Binding ProgressDisplay}"
                                               FontFamily="DMSansMedium" FontSize="13"
                                               TextColor="{StaticResource ForgeAccent}"/>
                                        <ProgressBar Progress="{Binding ProgressPercent}"
                                                     ProgressColor="{StaticResource ForgeAccent}"
                                                     HeightRequest="4"/>
                                    </VerticalStackLayout>

                                    <!-- Actions -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <BoxView Grid.Column="0" BackgroundColor="Transparent"/>
                                        <Button Grid.Column="1"
                                                Text="{loc:Localize Common_Delete}"
                                                FontFamily="DMSansMedium" FontSize="13"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource ForgeDestructiveText}"
                                                Padding="12,4"
                                                HeightRequest="44"
                                                MinimumWidthRequest="44"
                                                SemanticProperties.Description="{Binding DeleteA11y}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PeriodizationViewModel}}, Path=DeleteMesocycleCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </StackLayout>

                <!-- Bottom padding -->
                <BoxView HeightRequest="120" BackgroundColor="Transparent"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom gradient fade -->
        <BoxView InputTransparent="True" VerticalOptions="End" HeightRequest="150">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{AppThemeBinding Light=#00FCFCFC, Dark=#00141418}" Offset="0.0"/>
                    <GradientStop Color="{AppThemeBinding Light=#38FCFCFC, Dark=#38141418}" Offset="0.35"/>
                    <GradientStop Color="{AppThemeBinding Light=#90FCFCFC, Dark=#90141418}" Offset="0.65"/>
                    <GradientStop Color="{AppThemeBinding Light=#FCFCFC, Dark=#141418}" Offset="1.0"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

    </Grid>
</ContentPage>
