<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LockIn.ViewModels"
             xmlns:controls="clr-namespace:LockIn.Controls"
             xmlns:loc="clr-namespace:LockIn.Resources.Strings"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             ios:Page.UseSafeArea="False"
             x:Class="LockIn.Views.TemplatePickerPage"
             x:DataType="vm:TemplatePickerViewModel"
             Title="{loc:Localize TemplatePicker_Title}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="Transparent">

    <Grid SafeAreaEdges="None">

        <!-- Atmosfärisk bakgrund -->
        <controls:AtmosphericBackgroundView InputTransparent="True"/>

        <!-- Status-bar gradient -->
        <BoxView VerticalOptions="Start" HeightRequest="90" InputTransparent="True" ZIndex="19">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{AppThemeBinding Light=#28FCFCFC, Dark=#28141418}" Offset="0.0"/>
                    <GradientStop Color="{AppThemeBinding Light=#00FCFCFC, Dark=#00141418}" Offset="1.0"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Loader -->
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource ForgeAccent}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           ZIndex="30"/>

        <!-- ===== Kort-lista (visas när ingen template vald) ===== -->
        <ScrollView VerticalScrollBarVisibility="Never"
                    IsVisible="{Binding IsConfigOpen, Converter={x:Static vm:InverseBoolConverter.Instance}}">
            <VerticalStackLayout Spacing="0">

                <!-- Header med tillbaka-pil -->
                <Grid Padding="16,56,16,10" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Grid.Column="0"
                            Style="{StaticResource IconCircleButton}"
                            SemanticProperties.Description="{loc:Localize A11y_Back}">
                        <Path Style="{StaticResource BackChevron}"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <Label Grid.Column="1"
                           Text="{loc:Localize TemplatePicker_Title}"
                           FontFamily="BebasNeue" FontSize="30" CharacterSpacing="1"
                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource ForgeText}}"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- Subtext -->
                <Label Text="{loc:Localize TemplatePicker_Subtitle}"
                       FontFamily="DMSansRegular" FontSize="13"
                       LineHeight="1.4"
                       Padding="20,0,20,18"
                       TextColor="{StaticResource ForgeMuted}"/>

                <!-- Kort-lista -->
                <StackLayout BindableLayout.ItemsSource="{Binding Templates}" Spacing="0" Padding="0,4,0,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:TemplateCard">
                            <Border Margin="16,0,16,12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource ForgeSurface}}"
                                    StrokeShape="RoundRectangle 18"
                                    StrokeThickness="0"
                                    Padding="18,16">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,3" Radius="12" Opacity="0.2"/>
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TemplatePickerViewModel}}, Path=SelectTemplateCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Name}"
                                           FontFamily="BebasNeue" FontSize="22" CharacterSpacing="1"
                                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource ForgeText}}"/>
                                    <Label Text="{Binding DaysDisplay}"
                                           FontFamily="DMSansMedium" FontSize="13"
                                           TextColor="{StaticResource ForgeAccent}"/>
                                    <Label Text="{Binding Description}"
                                           FontFamily="DMSansRegular" FontSize="13"
                                           LineBreakMode="WordWrap"
                                           TextColor="{StaticResource ForgeMuted}"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </StackLayout>

                <!-- Bottom padding -->
                <BoxView HeightRequest="120" BackgroundColor="Transparent"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== Config-panel (fullhöjd, visas när template vald) ===== -->
        <Grid IsVisible="{Binding IsConfigOpen}" ZIndex="20">

            <!-- Bakgrundsplatta så att kort-listan under inte "skiner igenom" -->
            <BoxView BackgroundColor="{AppThemeBinding Light=#FCFCFC, Dark=#141418}"/>

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Header: stäng + titel -->
                <Grid Grid.Row="0" Padding="16,56,16,10" ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0"
                            Style="{StaticResource IconCircleButton}"
                            SemanticProperties.Description="{loc:Localize A11y_Close}">
                        <Label Text="✕"
                               FontFamily="BebasNeue" FontSize="18"
                               TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource ForgeText}}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseConfigCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="12,0,0,0" VerticalOptions="Center">
                        <Label Text="{Binding SelectedTemplate.Name}"
                               FontFamily="BebasNeue" FontSize="22" CharacterSpacing="1"
                               TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource ForgeText}}"/>
                        <Label Text="{loc:Localize TemplatePicker_Config_Title}"
                               FontFamily="DMSansRegular" FontSize="12"
                               TextColor="{StaticResource ForgeMuted}"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Scroll: fält -->
                <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="0" Padding="20,10,20,20">

                        <!-- Namn -->
                        <Label Text="{loc:Localize TemplatePicker_Name_Placeholder}"
                               FontFamily="BebasNeue" FontSize="14" CharacterSpacing="1.5"
                               TextColor="{StaticResource ForgeMuted}"
                               Margin="0,10,0,6"/>
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource ForgeSurface}}"
                                StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                Padding="14,4">
                            <Entry Text="{Binding MesocycleName, Mode=TwoWay}"
                                   Placeholder="{loc:Localize TemplatePicker_Name_Placeholder}"
                                   FontFamily="DMSansRegular" FontSize="15"
                                   BackgroundColor="Transparent"/>
                        </Border>
                        <!-- Förklarar varför SKAPA MESOCYKEL är inaktiv -->
                        <Label Text="{loc:Localize MesoBuilder_Error_NameRequired}"
                               IsVisible="{Binding ShowNameRequiredHint}"
                               FontFamily="DMSansRegular" FontSize="12"
                               TextColor="{StaticResource ForgeTextSecondary}"
                               Margin="0,6,0,0"/>

                        <!-- Startdatum -->
                        <Label Text="{loc:Localize TemplatePicker_StartDate_Label}"
                               FontFamily="BebasNeue" FontSize="14" CharacterSpacing="1.5"
                               TextColor="{StaticResource ForgeMuted}"
                               Margin="0,20,0,6"/>
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource ForgeSurface}}"
                                StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                Padding="14,4">
                            <DatePicker Date="{Binding StartDate, Mode=TwoWay}"
                                        FontFamily="DMSansRegular" FontSize="15"
                                        BackgroundColor="Transparent"/>
                        </Border>

                        <!-- Veckor -->
                        <Label Text="{loc:Localize TemplatePicker_Weeks_Label}"
                               FontFamily="BebasNeue" FontSize="14" CharacterSpacing="1.5"
                               TextColor="{StaticResource ForgeMuted}"
                               Margin="0,20,0,6"/>
                        <HorizontalStackLayout Spacing="8">
                            <Border BackgroundColor="{Binding IsWeeks4, Converter={x:Static vm:BoolToAccentBgConverter.Instance}}"
                                    Stroke="{StaticResource ForgeAccent}"
                                    StrokeThickness="{Binding IsWeeks4, Converter={x:Static vm:BoolToStrokeConverter.Instance}}"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="52" HeightRequest="44">
                                <Label Text="4"
                                       FontFamily="BebasNeue" FontSize="20"
                                       TextColor="{Binding IsWeeks4, Converter={x:Static vm:BoolToAccentFgConverter.Instance}}"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetWeeksCommand}" CommandParameter="4"/>
                                </Border.GestureRecognizers>
                            </Border>
                            <Border BackgroundColor="{Binding IsWeeks5, Converter={x:Static vm:BoolToAccentBgConverter.Instance}}"
                                    Stroke="{StaticResource ForgeAccent}"
                                    StrokeThickness="{Binding IsWeeks5, Converter={x:Static vm:BoolToStrokeConverter.Instance}}"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="52" HeightRequest="44">
                                <Label Text="5"
                                       FontFamily="BebasNeue" FontSize="20"
                                       TextColor="{Binding IsWeeks5, Converter={x:Static vm:BoolToAccentFgConverter.Instance}}"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetWeeksCommand}" CommandParameter="5"/>
                                </Border.GestureRecognizers>
                            </Border>
                            <Border BackgroundColor="{Binding IsWeeks6, Converter={x:Static vm:BoolToAccentBgConverter.Instance}}"
                                    Stroke="{StaticResource ForgeAccent}"
                                    StrokeThickness="{Binding IsWeeks6, Converter={x:Static vm:BoolToStrokeConverter.Instance}}"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="52" HeightRequest="44">
                                <Label Text="6"
                                       FontFamily="BebasNeue" FontSize="20"
                                       TextColor="{Binding IsWeeks6, Converter={x:Static vm:BoolToAccentFgConverter.Instance}}"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetWeeksCommand}" CommandParameter="6"/>
                                </Border.GestureRecognizers>
                            </Border>
                            <Border BackgroundColor="{Binding IsWeeks7, Converter={x:Static vm:BoolToAccentBgConverter.Instance}}"
                                    Stroke="{StaticResource ForgeAccent}"
                                    StrokeThickness="{Binding IsWeeks7, Converter={x:Static vm:BoolToStrokeConverter.Instance}}"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="52" HeightRequest="44">
                                <Label Text="7"
                                       FontFamily="BebasNeue" FontSize="20"
                                       TextColor="{Binding IsWeeks7, Converter={x:Static vm:BoolToAccentFgConverter.Instance}}"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetWeeksCommand}" CommandParameter="7"/>
                                </Border.GestureRecognizers>
                            </Border>
                            <Border BackgroundColor="{Binding IsWeeks8, Converter={x:Static vm:BoolToAccentBgConverter.Instance}}"
                                    Stroke="{StaticResource ForgeAccent}"
                                    StrokeThickness="{Binding IsWeeks8, Converter={x:Static vm:BoolToStrokeConverter.Instance}}"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="52" HeightRequest="44">
                                <Label Text="8"
                                       FontFamily="BebasNeue" FontSize="20"
                                       TextColor="{Binding IsWeeks8, Converter={x:Static vm:BoolToAccentFgConverter.Instance}}"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetWeeksCommand}" CommandParameter="8"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </HorizontalStackLayout>
                        <Label Text="{loc:Localize TemplatePicker_Deload_Note}"
                               FontFamily="DMSansRegular" FontSize="12"
                               TextColor="{StaticResource ForgeMuted}"
                               Margin="0,8,0,0"/>

                        <!-- Enhet -->
                        <Label Text="{loc:Localize TemplatePicker_Unit_Label}"
                               FontFamily="BebasNeue" FontSize="14" CharacterSpacing="1.5"
                               TextColor="{StaticResource ForgeMuted}"
                               Margin="0,20,0,6"/>
                        <HorizontalStackLayout Spacing="8">
                            <Border BackgroundColor="{Binding IsUnitKg, Converter={x:Static vm:BoolToAccentBgConverter.Instance}}"
                                    Stroke="{StaticResource ForgeAccent}"
                                    StrokeThickness="{Binding IsUnitKg, Converter={x:Static vm:BoolToStrokeConverter.Instance}}"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="80" HeightRequest="44">
                                <Label Text="KG"
                                       FontFamily="BebasNeue" FontSize="18" CharacterSpacing="1.5"
                                       TextColor="{Binding IsUnitKg, Converter={x:Static vm:BoolToAccentFgConverter.Instance}}"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetUnitKgCommand}"/>
                                </Border.GestureRecognizers>
                            </Border>
                            <Border BackgroundColor="{Binding IsUnitLb, Converter={x:Static vm:BoolToAccentBgConverter.Instance}}"
                                    Stroke="{StaticResource ForgeAccent}"
                                    StrokeThickness="{Binding IsUnitLb, Converter={x:Static vm:BoolToStrokeConverter.Instance}}"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="80" HeightRequest="44">
                                <Label Text="LB"
                                       FontFamily="BebasNeue" FontSize="18" CharacterSpacing="1.5"
                                       TextColor="{Binding IsUnitLb, Converter={x:Static vm:BoolToAccentFgConverter.Instance}}"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetUnitLbCommand}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- Footer: SKAPA MESOCYKEL -->
                <Grid Grid.Row="2" Padding="20,10,20,34">
                    <Button Text="{loc:Localize TemplatePicker_Create}"
                            IsEnabled="{Binding CanCreate}"
                            FontFamily="BebasNeue" FontSize="17" CharacterSpacing="2"
                            BackgroundColor="{StaticResource ForgeAccent}"
                            TextColor="{StaticResource ForgeFabForeground}"
                            HeightRequest="56"
                            CornerRadius="14"
                            Command="{Binding CreateCommand}"/>
                </Grid>

            </Grid>
        </Grid>

    </Grid>
</ContentPage>
