<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:strings="clr-namespace:LockIn.Resources.Strings"
    xmlns:vm="clr-namespace:LockIn.ViewModels"
    x:Class="LockIn.Views.JointPainSheet"
    x:DataType="vm:JointPainSheetViewModel"
    CanBeDismissedByTappingOutsideOfPopup="True"
    BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource ForgeSurface2}}">

    <Border StrokeShape="RoundRectangle 24,24,0,0"
            BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource ForgeSurface2}}"
            StrokeThickness="0"
            Padding="24,20,24,32"
            MinimumWidthRequest="320">

        <VerticalStackLayout Spacing="16">

            <BoxView WidthRequest="36" HeightRequest="4" CornerRadius="2"
                     HorizontalOptions="Center"
                     BackgroundColor="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource ForgeBorder}}"/>

            <Label Text="{Binding Question}"
                   FontFamily="BebasNeue" FontSize="26" CharacterSpacing="0.5"
                   LineHeight="1"
                   Margin="0,4,0,0"
                   TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource ForgeText}}"/>

            <!-- Option rows -->
            <VerticalStackLayout Spacing="10">

                <Border StrokeShape="RoundRectangle 12"
                        StrokeThickness="1.5"
                        Padding="16,14"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface2}, Dark={StaticResource ForgeSurface3}}"
                        Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource ForgeBorder}}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsNoneSelected}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource ForgeAccentAmber}"/>
                            <Setter Property="BackgroundColor" Value="{StaticResource ForgeAccentAmberDim}"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectCommand}" CommandParameter="0"/>
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static strings:AppResources.Feedback_JointPain_None}"
                           FontFamily="DMSansMedium" FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource ForgeText}}"/>
                </Border>

                <Border StrokeShape="RoundRectangle 12"
                        StrokeThickness="1.5"
                        Padding="16,14"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface2}, Dark={StaticResource ForgeSurface3}}"
                        Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource ForgeBorder}}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsLowSelected}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource ForgeAccentAmber}"/>
                            <Setter Property="BackgroundColor" Value="{StaticResource ForgeAccentAmberDim}"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectCommand}" CommandParameter="1"/>
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static strings:AppResources.Feedback_JointPain_Low}"
                           FontFamily="DMSansMedium" FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource ForgeText}}"/>
                </Border>

                <Border StrokeShape="RoundRectangle 12"
                        StrokeThickness="1.5"
                        Padding="16,14"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface2}, Dark={StaticResource ForgeSurface3}}"
                        Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource ForgeBorder}}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsModerateSelected}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource ForgeAccentAmber}"/>
                            <Setter Property="BackgroundColor" Value="{StaticResource ForgeAccentAmberDim}"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectCommand}" CommandParameter="2"/>
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static strings:AppResources.Feedback_JointPain_Moderate}"
                           FontFamily="DMSansMedium" FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource ForgeText}}"/>
                </Border>

                <Border StrokeShape="RoundRectangle 12"
                        StrokeThickness="1.5"
                        Padding="16,14"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface2}, Dark={StaticResource ForgeSurface3}}"
                        Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource ForgeBorder}}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsALotOfSelected}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource ForgeAccentCoral}"/>
                            <Setter Property="BackgroundColor" Value="{StaticResource ForgeAccentCoralDim}"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectCommand}" CommandParameter="3"/>
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static strings:AppResources.Feedback_JointPain_ALotOf}"
                           FontFamily="DMSansMedium" FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource ForgeText}}"/>
                </Border>

            </VerticalStackLayout>

            <!-- Actions -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                <Button Grid.Column="0"
                        Text="{x:Static strings:AppResources.Feedback_JointPain_Skip}"
                        Command="{Binding SkipCommand}"
                        FontFamily="DMSansMedium" FontSize="14"
                        BackgroundColor="Transparent"
                        BorderColor="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource ForgeBorder}}"
                        BorderWidth="1"
                        TextColor="{AppThemeBinding Light={StaticResource LightMuted}, Dark={StaticResource ForgeMuted}}"
                        CornerRadius="12"
                        HeightRequest="48"/>
                <Button Grid.Column="1"
                        Text="{x:Static strings:AppResources.Feedback_JointPain_Save}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}"
                        FontFamily="DMSansMedium" FontSize="14"
                        BackgroundColor="{StaticResource ForgeAccent}"
                        TextColor="#161618"
                        CornerRadius="12"
                        HeightRequest="48"/>
            </Grid>

        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
